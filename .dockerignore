.github/
node_modules/
**/node_modules/
.env
.env.*
!.env.example
.DS_Store
**/.DS_Store
Thumbs.db
npm-debug.log*
yarn-error.log*
*.log
coverage/
playwright-report/
test-results/
__pycache__/
**/__pycache__/
*.pyc
.idea/
.vscode/
